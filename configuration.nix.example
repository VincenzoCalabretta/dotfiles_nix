# Paste-ready NixOS configuration.
# See hosts/home/configuration.nix and hosts/server/configuration.nix for
# self-contained examples. This file shows how an external flake imports the
# shared nixosModules from this repo.
#
# This file expects your system flake to pass `inputs` through `specialArgs`:
#   specialArgs = { inherit inputs; };
# and to define an `inputs.dotfiles` flake input pointing at this repository.

{ pkgs, inputs, ... }:

{
  imports = [
    ./hardware-configuration.nix
    inputs.dotfiles.nixosModules.wireguard
  ];

  boot = {
    loader.systemd-boot.enable = true;
    loader.efi.canTouchEfiVariables = true;
    kernelPackages = pkgs.linuxPackages_latest;

    initrd.luks.devices."luks-517f231b-27b9-4de9-9942-8f415a04aaea".device =
      "/dev/disk/by-uuid/517f231b-27b9-4de9-9942-8f415a04aaea";
  };

  networking = {
    hostName = "nixos";
    networkmanager.enable = true;
  };

  time.timeZone = "Europe/Rome";

  i18n = {
    defaultLocale = "en_US.UTF-8";
    extraLocaleSettings = {
      LC_ADDRESS = "it_IT.UTF-8";
      LC_IDENTIFICATION = "it_IT.UTF-8";
      LC_MEASUREMENT = "it_IT.UTF-8";
      LC_MONETARY = "it_IT.UTF-8";
      LC_NAME = "it_IT.UTF-8";
      LC_NUMERIC = "it_IT.UTF-8";
      LC_PAPER = "it_IT.UTF-8";
      LC_TELEPHONE = "it_IT.UTF-8";
      LC_TIME = "it_IT.UTF-8";
    };
  };

  services.xserver = {
    enable = true;
    xkb.layout = "us";
    xkb.variant = "";
    windowManager.i3.enable = true;
    displayManager.startx.enable = true;
  };

  users.users.v = {
    isNormalUser = true;
    description = "v";
    extraGroups = [ "networkmanager" "wheel" ];
    shell = pkgs.zsh;
  };

  nixpkgs.config.allowUnfree = true;

  environment.systemPackages = with pkgs; [
    vim
    wget
    git
    neovim
  ];

  services.openssh.enable = true;

  programs.zsh.enable = true;
  nix.settings.experimental-features = [ "nix-command" "flakes" ];

  # wg1 (/etc/wireguard/wg1.conf) starts at boot.  wg3
  # (/etc/wireguard/wg3.conf) is available manually via:
  #   sudo systemctl start wg-quick-wg3
  dotfiles.wireguard.enable = true;

  # Keep the state version from your original installation.
  system.stateVersion = "26.05";
}
